{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tchaikovsky Nutcracker Music Game",
  "version": "0.1.0",
  "identifier": "com.jippylong12.nutcracker-music-game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tchaikovsky Nutcracker: The Music Game",
        "width": 1280,
        "height": 960,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "copyright": "Private local preservation build; original media remains third-party copyrighted material.",
    "shortDescription": "A private local preservation remake of Tchaikovsky's Nutcracker: The Music Game.",
    "longDescription": "A private local preservation remake built from Marcus Salinas's recovered copy of Tchaikovsky's Nutcracker: The Music Game. Not licensed for public redistribution with the original media.",
    "targets": ["app", "dmg"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
