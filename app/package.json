{
  "name": "nutcracker-music-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets:pipeline": "node scripts/generate-asset-pipeline.mjs",
    "assets:nutcracker-actors": "node scripts/promote-nutcracker-actor-assets.mjs",
    "assets:nutcracker-jpeg3": "node scripts/extract-nutcracker-jpeg3.mjs",
    "assets:nutcracker-swf": "node scripts/extract-nutcracker-swf-assets.mjs",
    "assets:nutcracker-ui": "node scripts/promote-nutcracker-ui-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:mac": "tauri build --bundles app,dmg --no-sign"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.4.1",
    "happy-dom": "^20.10.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
